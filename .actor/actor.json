{
  "actorSpecification": 1,
  "name": "magicbricks-99acres-property-scraper",
  "title": "MagicBricks + 99acres Property Scraper",
  "description": "Scrape Indian property listings from MagicBricks and 99acres with prices, BHK, area, locality, project, images, and listing URLs. No login or API key required.",
  "version": "1.0",
  "buildTag": "latest",
  "dockerfile": "./Dockerfile",
  "readme": "../README.md",
  "input": "../INPUT_SCHEMA.json",
  "output": "./output_schema.json",
  "storages": {
    "dataset": "./dataset_schema.json"
  },
  "categories": ["REAL_ESTATE", "OTHER"],
  "memoryMbytes": 2048,
  "timeoutSecs": 1800,
  "defaultRunOptions": {
    "memoryMbytes": 2048,
    "timeoutSecs": 1800
  },
  "exampleRunInput": {
    "contentType": "application/json; charset=utf-8",
    "body": "{\n  \"source\": \"both\",\n  \"transactionType\": \"sale\",\n  \"cities\": [\"Mumbai\"],\n  \"maxResults\": 10,\n  \"proxyConfiguration\": {\n    \"useApifyProxy\": true,\n    \"apifyProxyGroups\": [\"RESIDENTIAL\"],\n    \"apifyProxyCountry\": \"IN\"\n  }\n}"
  },
  "pricingInfo": {
    "pricingModel": "PAY_PER_EVENT",
    "pricingPerEvent": {
      "actorChargeEvents": {
        "apify-actor-start": {
          "eventTitle": "Actor start",
          "eventDescription": "Charged when the run starts to cover startup and the residential proxy session. Number of events depends on memory (one per GB, minimum one).",
          "eventPriceUsd": 0.001,
          "isPrimaryEvent": false,
          "isOneTimeEvent": true
        },
        "property-scraped": {
          "eventTitle": "Property scraped",
          "eventDescription": "Charged once for each clean property listing saved to the dataset.",
          "eventPriceUsd": 0.003,
          "isPrimaryEvent": true,
          "isOneTimeEvent": false
        }
      }
    }
  }
}
