{
  "actorSpecification": 1,
  "name": "magicbricks-99acres-property-scraper",
  "title": "MagicBricks & 99acres Property Data Scraper",
  "description": "Scrape filtered MagicBricks and 99acres searches with prices, amenities and source coverage. Optional bounded watchlists compare asking-price changes, normalize supported area units and export quality flags plus a change CSV.",
  "version": "1.0",
  "buildTag": "latest",
  "dockerfile": "./Dockerfile",
  "readme": "../README.md",
  "input": "../INPUT_SCHEMA.json",
  "output": "./output_schema.json",
  "storages": {
    "dataset": "./dataset_schema.json"
  },
  "categories": ["REAL_ESTATE", "OTHER"],
  "categoriesVersion": "1.0.0",
  "defaultRunOptions": {
    "build": "latest",
    "memoryMbytes": 512,
    "timeoutSecs": 3600
  },
  "minMemoryMbytes": 512,
  "maxMemoryMbytes": 512,
  "exampleRunInput": {
    "contentType": "application/json; charset=utf-8",
    "body": "{\"source\":\"magicbricks\",\"transactionType\":\"sale\",\"cities\":[\"Mumbai\"],\"maxResults\":1,\"proxyConfiguration\":{\"useApifyProxy\":true,\"apifyProxyGroups\":[\"RESIDENTIAL\"],\"apifyProxyCountry\":\"IN\"}}"
  },
  "pricingInfo": {
    "pricingModel": "PAY_PER_EVENT",
    "pricingPerEvent": {
      "actorChargeEvents": {
        "apify-actor-start": {
          "eventTitle": "Actor Start",
          "eventDescription": "Charged when the Actor starts. Number of events depends on memory (one per GB, minimum one).",
          "eventPriceUsd": 0.00005,
          "isPrimaryEvent": false,
          "isOneTimeEvent": true
        },
        "property-scraped": {
          "eventTitle": "Property scraped",
          "eventDescription": "Charged once for each clean property listing saved to the dataset.",
          "eventTieredPricingUsd": {
            "FREE": { "tieredEventPriceUsd": 0.003 },
            "BRONZE": { "tieredEventPriceUsd": 0.00285 },
            "SILVER": { "tieredEventPriceUsd": 0.0027 },
            "GOLD": { "tieredEventPriceUsd": 0.00255 },
            "PLATINUM": { "tieredEventPriceUsd": 0.00255 },
            "DIAMOND": { "tieredEventPriceUsd": 0.00255 }
          },
          "isPrimaryEvent": true,
          "isOneTimeEvent": false
        }
      }
    }
  }
}
