{
  "actorSpecification": 1,
  "name": "magicbricks-99acres-property-scraper",
  "title": "MagicBricks + 99acres Property Scraper",
  "description": "Scrape Indian property listings from MagicBricks and 99acres with prices, BHK, area, locality, project, images, and listing URLs. No login or API key required.",
  "version": "1.0",
  "buildTag": "latest",
  "dockerfile": "./Dockerfile",
  "readme": "../README.md",
  "input": "../INPUT_SCHEMA.json",
  "output": "./output_schema.json",
  "storages": {
    "dataset": "./dataset_schema.json"
  },
  "categories": ["REAL_ESTATE", "OTHER"],
  "categoriesVersion": "1.0.0",
  "defaultRunOptions": {
    "build": "latest",
    "memoryMbytes": 4096,
    "timeoutSecs": 3600
  },
  "minMemoryMbytes": 4096,
  "maxMemoryMbytes": 4096,
  "exampleRunInput": {
    "contentType": "application/json; charset=utf-8",
    "body": "{\"source\":\"magicbricks\",\"transactionType\":\"sale\",\"cities\":[\"Mumbai\"],\"maxResults\":1,\"proxyConfiguration\":{\"useApifyProxy\":true,\"apifyProxyGroups\":[\"RESIDENTIAL\"],\"apifyProxyCountry\":\"IN\"}}"
  },
  "pricingInfo": {
    "pricingModel": "PAY_PER_EVENT",
    "pricingPerEvent": {
      "actorChargeEvents": {
        "apify-actor-start": {
          "eventTitle": "Actor Start",
          "eventDescription": "Charged when the Actor starts. Number of events depends on memory (one per GB, minimum one).",
          "eventPriceUsd": 0.00005,
          "isPrimaryEvent": false,
          "isOneTimeEvent": true
        },
        "property-scraped": {
          "eventTitle": "Property scraped",
          "eventDescription": "Charged once for each clean property listing saved to the dataset.",
          "eventPriceUsd": 0.003,
          "isPrimaryEvent": true,
          "isOneTimeEvent": false
        }
      }
    }
  }
}
