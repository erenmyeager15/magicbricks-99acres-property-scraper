{
    "title":  "MagicBricks + 99acres Property Scraper Input",
    "description":  "Collect public Indian property listings. For a low-cost first run, use MagicBricks, sale, Mumbai, one result, no price filters, and the recommended Residential India proxy.",
    "type":  "object",
    "schemaVersion":  1,
    "properties":  {
                       "source":  {
                                      "title":  "Source",
                                      "type":  "string",
                                      "description":  "Choose one portal or both. Start with MagicBricks for the smallest first run.",
                                      "editor":  "select",
                                      "enum":  [
                                                   "both",
                                                   "magicbricks",
                                                   "99acres"
                                               ],
                                      "enumTitles":  [
                                                         "Both",
                                                         "MagicBricks",
                                                         "99acres"
                                                     ],
                                      "default":  "magicbricks"
                                  },
                       "transactionType":  {
                                               "title":  "Transaction type",
                                               "type":  "string",
                                               "description":  "Scrape property listings for sale or rent.",
                                               "editor":  "select",
                                               "enum":  [
                                                            "sale",
                                                            "rent"
                                                        ],
                                               "enumTitles":  [
                                                                  "Sale",
                                                                  "Rent"
                                                              ],
                                               "default":  "sale"
                                           },
                       "cities":  {
                                      "title":  "Cities",
                                      "type":  "array",
                                      "description":  "Indian city names to search, for example Mumbai, Pune, Bengaluru, Delhi, Chennai, or Hyderabad. Start with one city.",
                                      "editor":  "stringList",
                                      "items":  {
                                                    "type":  "string"
                                                },
                                      "minItems":  1,
                                      "maxItems":  20,
                                      "default":  [
                                                      "Mumbai"
                                                  ]
                                  },
                       "minPrice":  {
                                        "title":  "Minimum price",
                                        "type":  "integer",
                                        "description":  "Optional minimum price in INR. Records with unknown prices are skipped when a price filter is used.",
                                        "editor":  "number",
                                        "minimum":  0
                                    },
                       "maxPrice":  {
                                        "title":  "Maximum price",
                                        "type":  "integer",
                                        "description":  "Optional maximum price in INR. Records with unknown prices are skipped when a price filter is used.",
                                        "editor":  "number",
                                        "minimum":  0
                                    },
                       "maxResults":  {
                                          "title":  "Maximum results",
                                          "type":  "integer",
                                          "description":  "Maximum number of unique property listings to save. Start with 1, inspect the output, and then scale up.",
                                          "editor":  "number",
                                          "minimum":  1,
                                          "maximum":  500,
                                          "default":  1
                                      },
                       "proxyConfiguration":  {
                                                  "title":  "Proxy configuration",
                                                  "type":  "object",
                                                  "description":  "Residential India proxy is recommended for reliable regional access and consumes platform resources.",
                                                  "editor":  "proxy",
                                                  "default":  {
                                                                  "useApifyProxy":  true,
                                                                  "apifyProxyGroups":  [
                                                                                           "RESIDENTIAL"
                                                                                       ],
                                                                  "apifyProxyCountry":  "IN"
                                                              }
                                              }
                   },
    "required":  [
                     "source",
                     "transactionType",
                     "cities",
                     "maxResults"
                 ]
}
